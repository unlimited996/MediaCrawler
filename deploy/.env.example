# =============================================================================
# 启动环境变量（复制为 deploy/.env 后改值；容器通过 env_file 读取）
#
#   cp deploy/.env.example deploy/.env && vi deploy/.env
#   docker compose -f docker-compose.split.yml --env-file deploy/.env up -d
#
# 改动后：docker compose -f docker-compose.split.yml up -d   # 会重建容器生效
# 也可以只重启：docker compose -f docker-compose.split.yml restart crawler library
#
# 说明：配置管理页里能调的参数（抓取间隔、并发、预算等）存在数据库里，
#       不放这里；这里只放**启动就决定、改数据库没用**的那部分。
# =============================================================================

# ---------------------------------------------------------------------------
# 数据库（两个服务共用同一个库）
# ---------------------------------------------------------------------------
CONFIG_DB_TYPE=postgres
POSTGRES_DB_HOST=www.joyeuse.cn
POSTGRES_DB_PORT=4321
POSTGRES_DB_USER=im
POSTGRES_DB_PWD=change-me
POSTGRES_DB_NAME=postgres

# 抓取结果落到哪里（jsonl / postgres / sqlite / csv / excel）
SAVE_DATA_OPTION=postgres

# ---------------------------------------------------------------------------
# Nacos 服务发现（两个服务都注册；library 靠它发现 crawler）
# ---------------------------------------------------------------------------
NACOS_ENABLED=1
# ⚠️ 填 OpenAPI 端口（8848 → 宿主 9000），不是控制台端口 8085！
#    Nacos 3.x 控制台在 8080（宿主 8085），客户端 API 在 8848（宿主 9000）
NACOS_SERVER=www.joyeuse.cn:9000
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# 客户端 API 版本：auto（自动探测）/ v3 / v1
NACOS_API=auto
# 保活间隔秒数：Nacos 3.x 无 beat 接口，靠定时重新注册续期，5s 稳定
NACOS_HEARTBEAT_SEC=5
# 只有需要调用 admin 接口（服务列表等）才要填；客户端注册/发现不需要
NACOS_USERNAME=
NACOS_PASSWORD=

# 注册名（也是 URL 里的服务名；LIBRARY_SERVICE_NAME 决定 /library 前缀的注册身份）
CRAWLER_SERVICE_NAME=mediacrawler-crawler
LIBRARY_SERVICE_NAME=mediacrawler-library

# Nacos 不可用时的静态兜底（compose 网络里用服务名当主机名）。
# 群晖 Docker GUI 单独起容器时没有 compose 服务名，改成 http://<宿主IP>:8001
# （并给 crawler 容器映射 18001:8001），或把两个容器放进同一个自定义 docker 网络。
CRAWLER_BASE_URL=http://crawler:8001
LIBRARY_BASE_URL=http://library:8081

# 注册到 Nacos 的 IP —— 网关会拿这个地址「直连」crawler，必须对端可达：
#   * docker compose：留空即可（自动探测到容器 IP，同一 compose 网络内互通）；
#   * 本地单机双进程：监听 127.0.0.1 时设 SERVICE_IP=127.0.0.1；
#   * 群晖 GUI 单独起容器 / 跨主机：填【群晖宿主机 LAN IP】（如 192.168.1.10），
#     并给 crawler 容器映射 18001:8001:8001。千万别填 127.0.0.1（指向容器自己，
#     library 网关从另一个容器连不上 → /crawler/api/** 全部 502）。
SERVICE_IP=

# ---------------------------------------------------------------------------
# 抓取执行器
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=1
# 0=API 只提供接口，抓取交给独立 worker 进程（默认，推荐）
# 1=调度器跑在 API 进程内（排障/单进程调试用）
SCHEDULER_IN_API=0
# API 发现 worker 不在线时自动拉起
WORKER_AUTO_SPAWN=1
SCHEDULER_MAX_CONCURRENCY=1
SCHEDULER_TICK_SEC=15

# 抓取间隔（秒，随机区间）——反风控主要靠它，别轻易调小
XHS_SLEEP_MIN_SEC=35
XHS_SLEEP_MAX_SEC=55
# 撞验证码时弹窗等人工处理的最长秒数（容器里没显示器，建议配合人工登录态）
XHS_CAPTCHA_WAIT_SEC=300

# 浏览器
HEADLESS=true
# 宿主机已有 Chrome 调试端口时可用 CDP 复用登录态；容器内一般留空
CDP_DEBUG_PORT=
# 登录态存放目录（compose 已挂 browser_data）
BROWSER_DATA_DIR=/app/browser_data

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 日志目录（compose 已把 ./logs 挂到 /app/logs）
LOG_DIR=/app/logs
# 时区
TZ=Asia/Shanghai
# 对外端口（都是宿主机端口，改这里不用改 compose）
# 容器内部仍是 8081 / 8001，CRAWLER_BASE_URL 用的是容器间地址，不受影响
LIBRARY_PORT=18081
CRAWLER_PORT=18001

# 本地 docker compose build 时用的 npm 源（构建前端）；国内默认走淘宝镜像
NPM_REGISTRY=https://registry.npmmirror.com
# 1 = 构建时跳过 npm build，直接沿用宿主机已构建好的 api/webui（省 1~2 分钟）
#     注意：CI 里始终重新构建，不读这个变量
SKIP_WEBUI_BUILD=0

# 内容库 API 前缀（story 接口返回的媒体/原始文件链接按它拼；
# 拆分部署下必须是 /library/api，单体模式也挂了同一前缀）
LIBRARY_API_PREFIX=/library/api

# 镜像仓库命名空间（compose 拉镜像用；CI 侧用仓库变量 TENCENT_NAMESPACE 覆盖）
TENCENT_NAMESPACE=unlimited996

# ---------------------------------------------------------------------------
# 腾讯云容器镜像仓库凭据（服务器一键脚本 deploy/server-update.sh 推送用）
#   ⚠️ 只写在本机 deploy/.env（已被 .gitignore），绝不提交到仓库或写进脚本
#   取值就是 GitHub 仓库 Settings → Secrets 里那两个
# ---------------------------------------------------------------------------
TENCENT_REGISTRY_USERNAME=
TENCENT_REGISTRY_PASSWORD=

# 构建时装哪个浏览器：chromium（完整）/ chromium-headless-shell（小约 600MB）
# 容器内 HEADLESS=true、无 X server，服务器构建/推送建议用 headless-shell
# 只影响 crawler 镜像：library 只装 requirements-core.txt，完全不含浏览器。
PLAYWRIGHT_BROWSER=chromium-headless-shell

# Debian apt 源：国内服务器构建用（deb.debian.org 在国内会卡死 apt-get）
# compose 默认已是 mirrors.ustc.edu.cn；CI 不读本文件，仍用官方源
APT_MIRROR=mirrors.ustc.edu.cn

# Python 包源：pypi.org / files.pythonhosted.org 在国内常读超时，
# compose 默认走阿里云；CI 不读本文件，仍用官方源
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# Playwright 浏览器下载源：留空 = 官方 cdn.playwright.dev。
# 若官方 CDN 在国内也慢，改成 https://npmmirror.com/mirrors/playwright/
PLAYWRIGHT_DOWNLOAD_HOST=
